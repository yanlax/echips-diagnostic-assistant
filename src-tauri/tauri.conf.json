{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echips Hardware Check",
  "version": "0.10.0",
  "identifier": "ru.echips.hardware-check",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Echips Hardware Check",
        "width": 1120,
        "height": 764,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
